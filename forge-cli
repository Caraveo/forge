#!/usr/bin/env python3
"""Command line front end for the Linux build.

Usage:
  forge-cli generate "a red apple"
  forge-cli enhance "a red apple"
  forge-cli background image.png [--out path]
  forge-cli upscale image.png [--out path]
  forge-cli rig model.glb [--out path]
  forge-cli resume project_directory
"""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from datetime import datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent
APP = ROOT / "forge-linux" / "app"
sys.path.insert(0, str(ROOT / "forge-linux"))

from app.core import config


def main() -> int:
    parser = argparse.ArgumentParser(prog="forge-cli")
    parser.add_argument("mode", choices=["generate", "enhance", "background", "upscale", "rig", "resume"])
    parser.add_argument("files", nargs="*")
    parser.add_argument("--config", type=Path)
    parser.add_argument("--out", type=Path)
    parser.add_argument("--quality", choices=["auto", "draft", "standard", "high"])
    parser.add_argument("--res", type=int, choices=(512, 1024))
    parser.add_argument("--steps", type=int)
    parser.add_argument("--seed", type=int, default=42)
    args = parser.parse_args()

    cfg_path = args.config or config.active_config_path()
    if not cfg_path.is_file():
        print("FORGE runtime is not installed. Run:", APP.parent / "install.sh", file=sys.stderr)
        return 2
    cfg = json.loads(cfg_path.read_text(encoding="utf-8-sig"))
    if args.mode == "resume":
        if len(args.files) != 1:
            parser.error("Choose one project folder to resume.")
        project = Path(args.files[0]).expanduser().resolve()
        if (project / "generation-request.json").is_file():
            parser.error("Reopen the FORGE window to resume this desktop project.")
        try:
            saved = json.loads((project / "generation.json").read_text(encoding="utf-8"))["inputs"]
        except (OSError, ValueError, KeyError) as exc:
            parser.error(f"Could not read the project's checkpoint: {exc}")
        command = [str(cfg["python"]), str(APP / "backend" / "runner.py"),
                   "--config", str(cfg_path), "--job", str(project), "--mode", saved["mode"],
                   "--quality", saved["quality"], "--seed", str(saved["seed"])]
        for key, option in (("source", "--input"), ("output", "--out"),
                            ("resolution", "--res"), ("steps", "--steps")):
            if saved.get(key) is not None:
                command.extend((option, str(saved[key])))
        return subprocess.run(command).returncode

    runner_mode = {"generate": "image"}.get(args.mode, args.mode)
    command = [str(cfg["python"]), str(APP / "backend" / "runner.py"),
               "--config", str(cfg_path), "--mode", runner_mode]
    if args.out:
        command += ["--out", str(args.out)]
    if args.quality:
        command += ["--quality", args.quality]
    if args.res:
        command += ["--res", str(args.res)]
    if args.steps:
        command += ["--steps", str(args.steps)]
    command += ["--seed", str(args.seed)]

    if args.mode in ("background", "upscale", "rig"):
        if len(args.files) != 1:
            print("This mode needs exactly one input file.", file=sys.stderr)
            return 2
        source = Path(args.files[0]).expanduser().resolve()
        if not source.is_file():
            print("Input file not found:", source, file=sys.stderr)
            return 2
        command += ["--input", str(source)]
        raw = args.mode
    else:
        raw = " ".join(args.files).strip()
        if not raw:
            print("Describe the asset to build.", file=sys.stderr)
            return 2

    # Put CLI jobs in the output directory, like the GUI does, so files are easy to find.
    job = Path(cfg["output"]).expanduser() / (runner_mode + "_" + datetime.now().strftime("%Y%m%d_%H%M%S_%f"))
    job.mkdir(parents=True, exist_ok=True)
    (job / "prompt.txt").write_text(raw, encoding="utf-8")
    command += ["--job", str(job)]
    if raw and (args.mode in ("generate", "model", "image", "enhance")):
        command += ["--name", job.name]
    print("$", *command)
    return subprocess.run(command).returncode


if __name__ == "__main__":
    sys.exit(main())
